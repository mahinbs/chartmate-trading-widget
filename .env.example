VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Stripe — set these as Supabase Edge Function secrets (not only in .env)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
#
# White-label checkout (create-checkout-session)
# STRIPE_PRICE_WL_1Y=price_...
# STRIPE_PRICE_WL_2Y=price_...
# STRIPE_PRICE_WL_5Y=price_...
#
# Optional internal test checkout (plan_id test_1_rupee)
# STRIPE_PRICE_TEST_1R=price_...
#
# Premium app plans: add new price IDs in Supabase secrets and map them in
# supabase/functions/create-checkout-session/index.ts (buildPriceIds), then add matching rows to
# src/constants/pricing.ts PRICING_PLANS for the /pricing UI.
